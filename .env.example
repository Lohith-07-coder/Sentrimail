APP_NAME=SentriMail
DEBUG=False

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=sentrimail

# Generate distinct values of at least 32 characters for production.
SECRET_KEY=sentrimail-dev-secret-key-32bytes-long-for-hs256
JWT_SECRET_KEY=sentrimail-dev-jwt-secret-key-32bytes-long-for-hs256
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

SESSION_COOKIE_NAME=sentrimail_session
REFRESH_COOKIE_NAME=sentrimail_refresh
# Set True when the application is served over HTTPS.
SECURE_COOKIES=False
COOKIE_SAMESITE=lax

MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Optional: used by future AI provider integrations.
OPENAI_API_KEY=
